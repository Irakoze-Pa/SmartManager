NODE_ENV=development
PORT=7310
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/smartshop-pro?retryWrites=true&w=majority
# Comma-separated when multiple deployed clients are allowed. In development,
# localhost and 127.0.0.1 ports are accepted automatically.
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
PLATFORM_JWT_SECRET=replace-with-a-different-32-character-random-secret
PLATFORM_JWT_EXPIRES_IN=2h 

